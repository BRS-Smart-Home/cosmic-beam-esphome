# Copy these entries into your ESPHome secrets (Device Builder -> Secrets).
# Never commit your real secrets.yaml.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# 32-byte base64 key - the Device Builder generates one for every new device,
# or create one with:  openssl rand -base64 32
cosmic_beam_api_key: "REPLACE_WITH_YOUR_OWN_KEY"

# Password for the fallback hotspot (min. 8 characters)
cosmic_beam_ap_password: "change-me-please"
